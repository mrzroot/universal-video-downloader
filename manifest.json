{
  "manifest_version": 3,
  "name": "Super Video Downloader (نامحدود و رایگان)",
  "version": "1.0.0",
  "description": "دانلود نامحدود و پرسرعت انواع ویدیوهای وب (MP4, M3U8, HLS, WebM) بدون محدودیت و بدون واترمارک",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Super Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
